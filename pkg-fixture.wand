-- The root module of the fixture. Its name has a hyphen, which a bare
-- import turns into `_`: `import github.com/wand-lang/pkg-fixture` binds
-- `pkg_fixture`.

let version = "0.2.0"

-- A greeting for someone, in the words given.
let greet greeting name = "%{greeting} %{name}"

-- A farewell for someone.
let bye name = "goodbye %{name}"
